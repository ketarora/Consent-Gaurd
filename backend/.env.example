# Consent Guard — Environment Variables
# Copy this to .env and fill in your values.

# LLM API key for the classifier.
# Set ONE of these — the system auto-detects which provider to use.
# Priority: GEMINI → OPENAI → ANTHROPIC

# Google Gemini (recommended — fast, cost-effective)
# GEMINI_API_KEY=

# OpenAI (alternative)
# OPENAI_API_KEY=

# Anthropic Claude (alternative)
ANTHROPIC_API_KEY=

# Model override (optional — defaults to provider-specific model):
#   Gemini:    gemini-2.0-flash
#   OpenAI:    gpt-4o-mini
#   Anthropic: claude-haiku-4-5-20251001
# CLASSIFIER_MODEL=

# Confidence threshold for holding a message (0.0-1.0).
# Messages with flags at or above this threshold are held.
CONFIDENCE_THRESHOLD=0.75
