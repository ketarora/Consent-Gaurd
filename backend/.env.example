# Consent Guard — Environment Variables
# Copy this to .env and fill in your values.

# Anthropic API key for Claude Haiku 4.5 classifier.
# Required for the LLM classification path. Without this,
# the classifier fails safe (holds messages for review).
ANTHROPIC_API_KEY=

# Claude model to use. Default is Claude Haiku 4.5.
CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# Confidence threshold for holding a message (0.0-1.0).
# Messages with flags at or above this threshold are held.
CONFIDENCE_THRESHOLD=0.75
